# Copy to .env and fill in. Never commit .env.
# Settings module: manage.py uses config.settings.dev, pytest uses config.settings.test.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Addresses this app answers to. Add your PC's Wi-Fi IP (see: ipconfig) so tablets/phones on
# the same network can open it, and run: python manage.py runserver 0.0.0.0:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# The app's address (shown on the room-code screen and login cards).
SITE_URL=http://127.0.0.1:8000
# HTTPS / proxy setups only: full origins allowed to submit forms, comma-separated.
CSRF_TRUSTED_ORIGINS=
# Developer panel on the right edge of pages (dev only). False = off. Restart after changing.
DEBUG_TOOLBAR=True
DATABASE_URL=sqlite:///db.sqlite3

# Email. Dev prints emails (incl. OTP codes) in the runserver terminal.
# For a real provider set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@localhost

# App behaviour
SESSION_EXPIRY_HOURS=3
MAX_VIDEO_UPLOAD_MB=50
AVATAR_PACK=default
